{
  "format": "lanka-flows/v1",
  "title": "FAQ з двох кроків",
  "description": "Меню з трьома кнопками, збір телефону з таймаутом, повідомлення власнику.",
  "flows": [
    {
      "key": "faq",
      "name": "❓ FAQ",
      "group": "Довідка",
      "trigger": {
        "type": "command",
        "value": "/faq"
      },
      "root": {
        "type": "message",
        "name": "Меню",
        "paragraphs": [
          "<b>Чим допомогти?</b>",
          "Оберіть питання:"
        ],
        "buttons": [
          [
            {
              "text": "Години роботи",
              "node": {
                "type": "message",
                "name": "Години роботи",
                "paragraphs": [
                  "Пн–Пт 9:00–18:00, Сб 10:00–15:00."
                ]
              }
            },
            {
              "text": "Адреса",
              "node": {
                "type": "message",
                "name": "Адреса",
                "paragraphs": [
                  "вул. Прикладна, 1",
                  "<a href=\"https://maps.example.com\">На мапі</a>"
                ]
              }
            }
          ],
          {
            "text": "Передзвоніть мені",
            "node": {
              "type": "wait_for_input",
              "name": "Телефон",
              "paragraphs": [
                "Надішліть номер телефону — передзвонимо протягом години."
              ],
              "content": {
                "variable_name": "phone",
                "input_kind": "contact",
                "button_text": "📱 Поділитись номером",
                "timeout_value": 10,
                "timeout_unit": "minutes"
              },
              "answer": {
                "type": "notify",
                "name": "Власнику",
                "paragraphs": [
                  "Запит на дзвінок від ###platform.first_name###: ###user.phone.phone_number###"
                ],
                "content": {
                  "target_chat_id": "{{owner_chat}}"
                },
                "next": {
                  "type": "message",
                  "name": "Дякуємо",
                  "paragraphs": [
                    "Дякуємо! Передзвонимо найближчим часом."
                  ]
                }
              },
              "timeout": {
                "type": "message",
                "name": "Без номера",
                "paragraphs": [
                  "Гаразд — напишіть /faq, коли буде зручно."
                ]
              }
            }
          },
          {
            "text": "Сайт",
            "node": {
              "type": "url",
              "name": "Сайт",
              "content": {
                "url": "https://example.com"
              }
            }
          }
        ]
      }
    }
  ]
}
