{
  "format": "lanka-flows/v1",
  "placeholders": [
    "bot.username",
    "bot.public_key",
    "owner_chat",
    "app_query",
    "app_query_and",
    "site_url",
    "flow.<key>"
  ],
  "trigger_types": [
    "command",
    "text_match",
    "none"
  ],
  "node_types": {
    "message": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "reply_keyboard": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "wait_for_input": {
      "slots": {
        "answer": 0,
        "timeout": 1
      },
      "series": {},
      "button_kind": false
    },
    "condition": {
      "slots": {
        "yes": 0,
        "no": 1
      },
      "series": {},
      "button_kind": false
    },
    "url": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": true
    },
    "script": {
      "slots": {
        "next": 0,
        "error": 1
      },
      "series": {},
      "button_kind": false
    },
    "navigation": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "delay": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "poll": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "web_app": {
      "slots": {
        "next": 0,
        "error": 1
      },
      "series": {
        "hooks": 10
      },
      "button_kind": true
    },
    "list_buttons": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": true
    },
    "check_subscription": {
      "slots": {
        "yes": 0,
        "no": 1
      },
      "series": {},
      "button_kind": false
    },
    "notify": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "share": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": true
    },
    "switch": {
      "slots": {},
      "series": {
        "branches": 0
      },
      "button_kind": false
    },
    "remind": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "remove_keyboard": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "typing": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "placeholder": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "visibility": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "copy_text": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": true
    },
    "announce": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    },
    "album": {
      "slots": {
        "next": 0
      },
      "series": {},
      "button_kind": false
    }
  },
  "enums": {
    "condition.operator": [
      "eq",
      "neq",
      "gt",
      "lt",
      "gte",
      "lte",
      "contains",
      "is_set",
      "is_null"
    ],
    "navigation.action": [
      "restart",
      "start_flow",
      "go_back",
      "delete_message",
      "delete_and_back"
    ],
    "wait_for_input.input_kind": [
      "text",
      "contact",
      "location",
      "photo",
      "document"
    ],
    "wait_for_input.timeout_unit": [
      "seconds",
      "minutes",
      "hours"
    ],
    "delay.delay_unit": [
      "seconds",
      "minutes",
      "hours"
    ],
    "remind.offset_unit": [
      "minutes",
      "hours",
      "days"
    ],
    "remind.offset_direction": [
      "before",
      "after"
    ],
    "notify.interrupt_level": [
      "when_free",
      "urgent"
    ],
    "announce.interrupt_level": [
      "when_free",
      "urgent"
    ],
    "share.mode": [
      "link",
      "inline"
    ],
    "navigation.message_mode": [
      "resend",
      "clear_history"
    ]
  },
  "safe_expr": {
